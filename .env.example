# ---------------------------------------------------------------------------
# Visual Book Diary — environment variables
# Copy this file to `.env.local` and fill in the values.
# `.env.local` is never committed (it is in .gitignore).
# ---------------------------------------------------------------------------

# Supabase — safe in the browser (the NEXT_PUBLIC_ prefix exposes them to the client).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase — SERVER ONLY. It bypasses row-level security; never expose it to the client.
SUPABASE_SERVICE_ROLE_KEY=
