# ---------------------------------------------------------------------------
# Visual Book Diary — Environment Variables (PRD Bölüm 8)
# Bu dosyayı `.env.local` olarak kopyalayıp değerleri doldurun.
# `.env.local` asla commit edilmez (.gitignore'da).
# ---------------------------------------------------------------------------

# Supabase — client'ta KULLANILABİLİR (NEXT_PUBLIC_ prefix'i tarayıcıya açar).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase — YALNIZCA server-side. RLS'i bypass eder, asla client'a sızdırmayın.
SUPABASE_SERVICE_ROLE_KEY=

# AI görsel üretimi — YALNIZCA server-side. Sağlayıcıya göre BİRİNİ doldurun.
# Birincil öneri: Replicate (Flux Schnell).
REPLICATE_API_TOKEN=
# Alternatif: OpenAI (gpt-image-1-mini).
OPENAI_API_KEY=
